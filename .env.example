# Copy to .env and fill in. NEVER commit a real .env file.
# docker-compose loads this automatically (env_file).

# --- LLM ---
# Provider: "anthropic" | "openai" | "mock". Leave empty for auto-select:
#   ANTHROPIC_API_KEY set -> anthropic,
#   else OPENAI_API_KEY set -> openai,
#   else mock (canned streaming replies, no key needed).
LLM_PROVIDER=
# Your Anthropic key (Claude). Wins auto-select when set.
ANTHROPIC_API_KEY=
# Claude model, e.g. claude-sonnet-4-6, claude-haiku-4-5
ANTHROPIC_MODEL=claude-sonnet-4-6
# Your OpenAI key. Used when set and no Anthropic key is present.
OPENAI_API_KEY=
# Any OpenAI chat model, e.g. gpt-4o, gpt-4o-mini, gpt-4-turbo
OPENAI_MODEL=gpt-4o
# Optional: override for proxies or Azure OpenAI-compatible endpoints
OPENAI_BASE_URL=

# --- Speech-to-text (Vosk, free, on-device) ---
VOSK_MODEL_NAME=vosk-model-small-en-us-0.15
VOSK_MODEL_DIR=/app/models
STT_SAMPLE_RATE=16000

# --- Text-to-speech (Edge TTS, free, no key needed) ---
TTS_ENABLED=true
TTS_VOICE=en-US-AriaNeural

# --- Conversation ---
MAX_HISTORY_MESSAGES=20
# SYSTEM_PROMPT=You are the AI Confessor, ...
